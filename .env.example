# Local dev (server.js reads these). Production Lambda gets these from
# CloudFormation params + GitHub Secrets, not this file.
PORT=3000
JWT_SECRET=change-me
ADMIN_EMAIL=admin@tracker.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Admin
APP_URL=http://localhost:3000

# AWS (data lives in DynamoDB + S3; region ap-south-1 for the live stack)
AWS_REGION=ap-south-1
UCT_S3_BUCKET=uct-tracker-state-000000000000
UCT_DDB_TABLE_PREFIX=Uct

# SMTP (optional; leave empty to disable outbound email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Task generation engine
TASK_GEN_ENABLED=true
TASK_GEN_INTERVAL_HOURS=24
